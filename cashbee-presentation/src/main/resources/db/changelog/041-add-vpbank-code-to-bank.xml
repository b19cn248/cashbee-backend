    <!--
        Changeset 041: Add vpbank_code to bank table
        Author: CashBee Team
        Date: 2025-12-23
        Description: Add vpbank_code column (9 digits) for VPBank batch transfer format
    -->

    <changeSet id="041-add-vpbank-code-to-bank" author="cashbee">
        <comment>Add vpbank_code column to bank table for VPBank batch transfer file format</comment>

        <addColumn tableName="bank">
            <column name="vpbank_code" type="VARCHAR(20)" remarks="Ma ngan hang theo chuan VPBank (9 chu so, vd: 101203001)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

