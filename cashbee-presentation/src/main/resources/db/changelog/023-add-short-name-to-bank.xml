    <!--
        Changeset 023: Add short_name to Bank Table
        Author: CashBee Team
        Date: 2025-11-20
        Description: Thêm trường short_name (tên viết tắt) vào bảng bank
                     để hiển thị tên ngắn gọn cho user
    -->

    <!-- Step 1: Add short_name column -->
    <changeSet id="023-01-add-short-name-column" author="cashbee">
        <comment>Thêm column short_name vào bảng bank</comment>

        <addColumn tableName="bank">
            <column name="short_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

