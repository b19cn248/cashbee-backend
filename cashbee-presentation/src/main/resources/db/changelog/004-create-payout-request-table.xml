<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-payout-request-table" author="cashbee-team">
        <comment>
            Create payout_requests table for user withdrawal requests.
            Handles complete payout workflow from request to completion.
        </comment>

        <createTable tableName="payout_requests">
            <!-- Primary Key -->
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- Foreign Keys -->
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="wallet_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Payout Details -->
            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>

            <column name="payout_method" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="account_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="account_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>

            <column name="bank_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>

            <!-- Status & Tracking -->
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="requested_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="processed_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>

            <column name="processed_by" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>

            <column name="completed_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>

            <column name="rejection_reason" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <!-- Indexes for Performance -->
        <createIndex indexName="idx_payout_user_id" tableName="payout_requests">
            <column name="user_id"/>
        </createIndex>

        <createIndex indexName="idx_payout_wallet_id" tableName="payout_requests">
            <column name="wallet_id"/>
        </createIndex>

        <createIndex indexName="idx_payout_status" tableName="payout_requests">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_payout_requested_at" tableName="payout_requests">
            <column name="requested_at"/>
        </createIndex>

        <!-- Composite index for common query pattern -->
        <createIndex indexName="idx_payout_user_status" tableName="payout_requests">
            <column name="user_id"/>
            <column name="status"/>
        </createIndex>

        <!-- Foreign Key Constraints -->
        <addForeignKeyConstraint
                baseTableName="payout_requests"
                baseColumnNames="user_id"
                constraintName="fk_payout_user"
                referencedTableName="user"
                referencedColumnNames="id"
                onDelete="CASCADE"
                onUpdate="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="payout_requests"
                baseColumnNames="wallet_id"
                constraintName="fk_payout_wallet"
                referencedTableName="user_wallet"
                referencedColumnNames="id"
                onDelete="CASCADE"
                onUpdate="CASCADE"/>

        <rollback>
            <dropTable tableName="payout_requests"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
