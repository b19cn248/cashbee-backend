<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="054-add-reset-token-to-otp-verification" author="claude">
        <comment>Add reset_token column to otp_verifications for password reset flow</comment>

        <addColumn tableName="otp_verifications">
            <column name="reset_token" type="VARCHAR(36)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <createIndex indexName="idx_otp_reset_token" tableName="otp_verifications">
            <column name="reset_token"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_otp_reset_token" tableName="otp_verifications"/>
            <dropColumn tableName="otp_verifications" columnName="reset_token"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
