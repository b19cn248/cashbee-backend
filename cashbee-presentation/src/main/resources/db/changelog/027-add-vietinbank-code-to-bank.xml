    <changeSet id="027-add-vietinbank-code-to-bank" author="cashbee">
        <comment>Add vietinbank_code column to bank table for VietinBank batch transfer integration</comment>

        <addColumn tableName="bank">
            <column name="vietinbank_code" type="VARCHAR(20)" remarks="Ma ngan hang theo chuan VietinBank (8 chu so)"/>
        </addColumn>
    </changeSet>

