<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Anti-fraud: Prevent multiple users from sharing the same bank account.
        Step 1: Delete older duplicate records (keep newest per bank_code + account_number).
                Cannot SET NULL because account_number and account_name have NOT NULL constraints.
                Affected users will need to re-enter their bank account info.
        Step 2: Add UNIQUE constraint on (bank_code, account_number).
    -->

    <!-- Step 1: Delete older duplicate bank accounts before adding constraint -->
    <changeSet id="053-01-cleanup-duplicate-bank-accounts" author="cashbee">
        <comment>Delete older duplicate bank accounts, keep newest record per bank_code + account_number</comment>
        <sql>
            DELETE uba FROM user_bank_account uba
            INNER JOIN (
                SELECT dup.id
                FROM user_bank_account dup
                INNER JOIN (
                    SELECT bank_code, account_number, MAX(id) AS max_id
                    FROM user_bank_account
                    WHERE bank_code IS NOT NULL AND account_number IS NOT NULL
                    GROUP BY bank_code, account_number
                    HAVING COUNT(*) > 1
                ) grp ON dup.bank_code = grp.bank_code
                     AND dup.account_number = grp.account_number
                     AND dup.id != grp.max_id
            ) old_dups ON uba.id = old_dups.id;
        </sql>
    </changeSet>

    <!-- Step 2: Add UNIQUE constraint (skip if already exists from previous partial run) -->
    <changeSet id="053-02-add-unique-bank-account-index" author="cashbee">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="user_bank_account" indexName="uk_bank_account_code_number"/>
            </not>
        </preConditions>
        <comment>Add UNIQUE constraint on (bank_code, account_number) to prevent duplicate bank accounts</comment>
        <addUniqueConstraint
                tableName="user_bank_account"
                columnNames="bank_code, account_number"
                constraintName="uk_bank_account_code_number"/>
        <rollback>
            <dropUniqueConstraint
                    tableName="user_bank_account"
                    constraintName="uk_bank_account_code_number"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
