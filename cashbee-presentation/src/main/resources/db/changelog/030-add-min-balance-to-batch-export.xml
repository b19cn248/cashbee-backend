<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="030-add-min-balance-to-batch-export" author="cashbee">
        <comment>Add min_balance column to batch_transfer_export table to store the minimum balance criteria used when creating batch</comment>

        <addColumn tableName="batch_transfer_export">
            <column name="min_balance" type="DECIMAL(15,2)" defaultValue="50000.00" remarks="Minimum balance criteria for batch export">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
